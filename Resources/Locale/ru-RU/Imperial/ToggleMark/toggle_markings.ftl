ent-ActionSuitToggleMarkingEars = Переключить видимость ушек
ent-ActionSuitToggleMarkingTail = Переключить видимость спины

imperial-toggle-marking-ears =
    { $visible ->
        [true] Вы демонстрируете свои ушки
        *[false] Вы скрываете свои ушки
    }

imperial-toggle-marking-tail =
    { $visible ->
        [true] Вы демонстрируете свою спину
        *[false] Вы скрываете свою спину
    }

