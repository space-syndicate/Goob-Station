ent-DrinkRedSpace = Red Space Energy
    .desc = Полулегальный напиток, изготовленный из телесинтета, запрещен к продаже несколько лет назад из-за высокого содержания этого вещества. Не рекомендуется для употребления новорожденными, беременными женщинами, пожилыми людьми и унатхами-инвалидами.
    .suffix = { "" }
ent-DrinkMilkshakeCarrotGlass = морковный молочный коктейль
    .desc = Разработан специально для любителей правильного питания. Чистое здоровье в стакане. Говорят, после него даже зрение улучшается. Или просто кружится голова от гордости за свой выбор.
    .suffix = { "" }
ent-DrinkMilkshakeCherryGlass = вишнёвый молочный коктейль
    .desc = Вкусная альтернатива кофе и газировке. Скорее всего, безопасная... Кисло-сладкий баланс, от которого щиплет язык. Яркий, как телекристалл, и такой же подозрительный.
    .suffix = { "" }
ent-DrinkMilkshakeStrawberryGlass = клубничный молочный коктейль
    .desc = Вкусная альтернатива кофе и газировке. Скорее всего, безопасная... Ягодный заряд бодрости без намёка на химию. Хотя кто знает наверняка?
    .suffix = { "" }
ent-DrinkMilkshakeChocolateGlass = шоколадный молочный коктейль
    .desc = Шоколадный коктейль для ценителей сладкой горчинки. Отличный вариант для пляжа или любителей шоколадного мороженного.
    .suffix = { "" }
ent-DrinkMilkshakeBananaGlass = банановый молочный коктейль
    .desc = Линейка банановых коктейлей в коллаборации с Honk Inc. Позволит каждому насладиться новым насыщенным вкусом священного плода клоунов.
    .suffix = { "" }
ent-FoodBoxBubblegum = упаковка жвачки
    .desc = Упаковка с вкусной и сладкой жвачкой.
    .suffix = { "" }
ent-FoodBubblegumPacked = жвачка в упаковке
    .desc = Вкусная жвачка в тёмной обёртке.
    .suffix = { "" }
ent-FoodBubblegum = жвачка
    .desc = Вкусная жвачка белого цвета. Не приклеивайте её под стол.
    .suffix = { "" }
ent-ChewedGum = жёванная жвачка
    .desc = Противный кусок жеваной резинки — от него всё ещё исходит сладковатый запах.
    .suffix = { "" }
ent-SyndicakesBox = коробка синди-кексов
    .desc = Коробка с вкуснейшими синди-кексами.
    .suffix = { "" }
ent-BorgModuleServiceLilith = сервисный модуль Лилит
    .desc = Особый модуль для создания молочных коктейлей, специально для моледей боргов типа Лилит.
    .suffix = { "" }
ent-VendingMachineMilkshake = МилкшейкМат "Redspace Milkshakes"
    .desc = Ретрофутуристично выглядящий автомат который производит молочные коктейли на основе химических опытов с редспейсом, позволившим имитировать вкус некоторых продуктов. Полностью безопасно для употребления! (По всем вопросам обращаться в "RedSpace ind.").
    .suffix = { "" }
ent-PillLuciferium = кристалл люциферия
    .desc = Кристалл сильнодействующего препарата, который связывается с организмом носителя. Стоит принять его лишь раз — и вы обречены использовать его вечно.
    .suffix = { "" }
ent-TerminalMilkshake = милкшейк терминал
    .desc = Специальный терминал для молочных коктейлей. Предназначен для покупки молочных коктейлей и других продуктов.
    .suffix = { "" }
ent-ChemistryBottleTelesynthet = бутылочка
    .desc = { ent-BaseChemistryEmptyBottle.desc }
    .suffix = { "Телесинтет" }
ent-BorgChassisLilith = Лилит
    .desc = Специализированный сервисный борг по приготовлению идеальных молочных коктейлей. Если жизнь одаривает вас молоком - делайте из него милкшейки!
    .suffix = { "" }
ent-PlayerBorgLilithBattery = Лилит
    .desc = { ent-BorgChassisLilith.desc }
    .suffix = { "Батарея, Модули" }
