uniform sampler2D SCREEN_TEXTURE;
uniform highp float intensity;

highp float hash(highp vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float noise(highp vec2 p) {
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    highp float a = hash(i);
    highp float b = hash(i + vec2(1.0, 0.0));
    highp float c = hash(i + vec2(0.0, 1.0));
    highp float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

highp float fbm(highp vec2 p) {
    highp float value = 0.0;
    highp float amplitude = 0.5;
    for (int i = 0; i < 4; i++) {
        value += amplitude * noise(p);
        p *= 2.03;
        amplitude *= 0.5;
    }
    return value;
}

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
    highp vec2 p = (uv - 0.5) * 2.0;
    p.x *= aspect;
    highp float r = length(p);
    highp float ang = atan(p.y, p.x);
    highp float ca = max(abs(cos(ang)), 0.0001);
    highp float sa = max(abs(sin(ang)), 0.0001);
    highp float depth = min(aspect / ca, 1.0 / sa) - r;
    highp float time = TIME;
    highp vec3 original = zTextureSpec(SCREEN_TEXTURE, uv).rgb;

    if (depth > 0.32) {
        COLOR = vec4(original, 1.0);
    } else {
        highp float edge = clamp(1.0 - depth * 4.0, 0.0, 1.0);
        highp vec2 wobble = vec2(sin(uv.y * 17.0 + time * 1.6), cos(uv.x * 13.0 + time * 1.2)) * (0.001 + 0.003 * edge);
        highp float aberration = 0.0025 * edge;
        highp vec3 color;
        color.r = zTextureSpec(SCREEN_TEXTURE, uv + wobble + vec2(aberration, 0.0)).r;
        color.g = zTextureSpec(SCREEN_TEXTURE, uv + wobble).g;
        color.b = zTextureSpec(SCREEN_TEXTURE, uv + wobble - vec2(aberration, 0.0)).b;

        highp float fog = fbm(vec2(p.x * 1.6 + time * 0.15, p.y * 1.6 - time * 0.1));
        highp float haze = clamp(exp(-depth * 10.0) * (0.55 + 0.6 * fog) - 0.1, 0.0, 1.0);

        highp float body = 0.0;
        highp float rim = 0.0;
        highp float shade = 0.0;
        for (int k = 0; k < 9; k++) {
            highp float fk = float(k);
            highp float baseAng = fk * 6.2831853 / 9.0 + 0.37 + 0.08 * sin(time * 0.3 + fk);
            highp float len = 0.22 + 0.07 * sin(time * 0.6 + fk * 1.9);
            highp float q = (depth + 0.03) / len;
            if (q < 0.0 || q > 1.0)
                continue;

            highp float sway = 0.22 * q * q * sin(q * 4.5 - time * 1.4 + fk * 2.1);
            highp float da = ang - (baseAng + sway / max(r, 0.2));
            da = atan(sin(da), cos(da));
            highp float lat = abs(da * r);
            highp float width = 0.06 * pow(1.0 - q, 0.85) + 0.003;
            highp float m = 1.0 - smoothstep(width * 0.75, width, lat);
            highp float rm = (1.0 - smoothstep(width, width * 1.5, lat)) * (1.0 - m);
            if (m > body) {
                body = m;
                shade = clamp(lat / max(width, 0.0001), 0.0, 1.0);
            }
            rim = max(rim, rm);
        }

        highp float n1 = noise(p * 2.4 + vec2(5.3, -1.7)) * 0.7 + noise(p * 5.1 + vec2(2.2, 7.9)) * 0.3;
        highp float n2 = noise(p * 5.5 + vec2(-3.1, 4.4)) * 0.7 + noise(p * 11.0 + vec2(1.3, -6.2)) * 0.3;
        highp float thick = clamp(1.0 - depth * 4.5, 0.0, 1.0);
        highp float line1 = 1.0 - smoothstep(0.0, 0.010 + 0.03 * thick, abs(n1 - 0.5));
        highp float line2 = 1.0 - smoothstep(0.0, 0.006 + 0.014 * thick, abs(n2 - 0.5));
        highp float vein = max(line1, line2 * 0.7) * (1.0 - smoothstep(0.03, 0.28, depth));
        highp float beat = pow(max(sin(time * 2.6 - depth * 7.0), 0.0), 3.0);
        highp float veinGlow = vein * (0.35 + 0.65 * beat);
        highp vec3 veinColor = vec3(0.30, 0.08, 0.62);

        highp vec3 hazeColor = vec3(0.09, 0.03, 0.24);
        highp vec3 dark = vec3(0.015, 0.0, 0.035);
        highp vec3 light = vec3(0.08, 0.03, 0.17);
        highp vec3 rimColor = vec3(0.48, 0.28, 0.95);

        color = mix(color, hazeColor, haze * 0.75);
        color = color * (1.0 - vein * 0.6) + veinColor * veinGlow;
        color += rimColor * rim * 0.12;
        color = mix(color, mix(light, dark, shade), body * 0.95);

        COLOR = vec4(mix(original, color, intensity), 1.0);
    }
}
