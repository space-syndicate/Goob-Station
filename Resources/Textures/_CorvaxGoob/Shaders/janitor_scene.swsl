light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

void fragment() {
    highp vec4 scene = zTextureSpec(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE);
    highp float luminance = dot(scene.rgb, vec3(0.298, 0.5882, 0.1137));
    highp vec3 tint = vec3(0.12, 0.38, 0.12);
    highp vec3 filtered = mix(scene.rgb, tint, clamp(luminance * 1.5, 0.0, 1.0));

    // A pure function of this frame's scene: no random grain, TIME, frame counter or feedback.
    // The same scene and strength produce the same image at every frame rate.
    COLOR = vec4(mix(scene.rgb, filtered, clamp(strength, 0.0, 1.0)), scene.a);
}
