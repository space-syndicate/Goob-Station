<Project>
  <!--
  Content specific properties
  Import *before* Robust.Properties.targets
  -->

  <PropertyGroup>
    <LangVersion Condition="'$(LangVersion)' == ''">14</LangVersion>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RA0049/RA0051: dependency/partial style (warnings upgraded by TreatWarningsAsErrors). CS0108/CS0414: common upstream merge noise. -->
    <WarningsNotAsErrors>CS0618,CS0672,CS0612,CS1062,CS1064,NU1901,NU1902,NU1903,NU1904,CS0108,CS0414,RA0048,RA0049,RA0050,RA0051,RA0052</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
