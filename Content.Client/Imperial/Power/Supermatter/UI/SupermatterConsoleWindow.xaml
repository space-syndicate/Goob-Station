<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      Title="{Loc 'supermatter-console-title'}"
                      SetSize="420 420"
                      Resizable="True">
  <BoxContainer Orientation="Vertical" Margin="4">

    <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 0 8">
      <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="{Loc 'supermatter-console-core-status'}" StyleClasses="LabelKeyText" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
          <Label Text="{Loc 'supermatter-console-integrity'}" StyleClasses="StatusFieldTitle" HorizontalExpand="True" />
          <Label Name="IntegrityValue" Text="—" FontColorOverride="#666666"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
          <Label Text="{Loc 'supermatter-console-event'}" StyleClasses="StatusFieldTitle" HorizontalExpand="True" />
          <Label Name="ActiveEventValue" Text="—" FontColorOverride="#666666"/>
        </BoxContainer>
      </BoxContainer>
    </PanelContainer>

    <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 0 8">
      <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="{Loc 'supermatter-console-thermodynamics'}" StyleClasses="LabelKeyText" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
          <Label Text="{Loc 'supermatter-console-temperature'}" StyleClasses="StatusFieldTitle" HorizontalExpand="True" />
          <Label Name="TemperatureValue" Text="0 K" FontColorOverride="#666666"/>
        </BoxContainer>

        <GridContainer Name="TemperatureMeter" Columns="10" VerticalExpand="True" Margin="0 15 0 0">
        </GridContainer>
      </BoxContainer>
    </PanelContainer>

    <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True">
      <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="{Loc 'supermatter-console-atmosphere'}" StyleClasses="LabelKeyText" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
          <Label Text="{Loc 'supermatter-console-pressure'}" StyleClasses="StatusFieldTitle" HorizontalExpand="True" />
          <Label Name="PressureValue"  Text="0 кПа" FontColorOverride="#666666"/>
        </BoxContainer>

        <GridContainer Name="PressureMeter" Columns="10" VerticalExpand="True" Margin="0 15 0 0">
        </GridContainer>
      </BoxContainer>
    </PanelContainer>

    <!-- Footer -->
    <BoxContainer Orientation="Vertical">
      <PanelContainer StyleClasses="LowDivider" />
      <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
          <Label Text="{Loc 'supermatter-console-flavor-left'}" StyleClasses="WindowFooterText" />
          <Label Text="{Loc 'supermatter-console-flavor-right'}" StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right" HorizontalExpand="True"  Margin="0 0 5 0" />
          <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                       VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
      </BoxContainer>
    </BoxContainer>
  </BoxContainer>
</controls:FancyWindow>
