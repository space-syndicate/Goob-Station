<iui:ChoiceWindow
    xmlns="https://spacestation14.io"
    xmlns:i="clr-namespace:Content.Client.Imperial.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:iui="clr-namespace:Content.Client.Imperial.UI.Windows.ChoiceWindow"
    HeaderText="Imperial"
    MinSize="525 195">
    <BoxContainer Name="Contents" Access="Public" Orientation="Vertical" VerticalAlignment="Center" Margin="18 43 18 18">
        <Label Name="HeaderLabelText" StyleClasses="LabelSubTextPass1" Access="Public" />

        <controls:HSpacer Spacing="5"/>
        <RichTextLabel Name="InfoText" StyleClasses="LabelSubTextPassMediumBuy" Access="Public" />
        <controls:HSpacer Spacing="20"/>

        <Label Name="ChoiceHeader" StyleClasses="LabelSubTextPassMediumBuy" Access="Public" />

        <BoxContainer Name="ChoicesContainer" Orientation="Horizontal" Margin="0 20 0 0" HorizontalExpand="True" HorizontalAlignment="Stretch">
        </BoxContainer>
    </BoxContainer>
</iui:ChoiceWindow>
