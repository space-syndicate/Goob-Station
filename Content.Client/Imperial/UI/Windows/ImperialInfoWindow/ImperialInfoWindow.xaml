<iui:ImperialInfoWindow
    xmlns="https://spacestation14.io"
    xmlns:i="clr-namespace:Content.Client.Imperial.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:iui="clr-namespace:Content.Client.Imperial.UI.Windows.ImperialInfoWindow"
    HeaderText="Imperial"
    MinWidth="600"
    MaxWidth="600"
    Resizable="False">
    <BoxContainer Name="Contents" Access="Public" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20 35 20 20">
        <RichTextLabel Name="HeaderLabelText" StyleClasses="LabelSubTextPass1" Access="Public" />
        <controls:HSpacer Spacing="10"/>

        <RichTextLabel Name="InfoText" StyleClasses="LabelSubTextPassMediumBuy" Access="Public" />
        <controls:HSpacer Spacing="20"/>

        <i:BaseImperialButton
            Name="SubmitButton"
            HorizontalAlignment="Stretch"
            HorizontalExpand="True"
            StyleClasses="ImperialRoundedButton"
            Access="Public">
           <Label Name="SubmitButtonText" Text="{Loc 'imperial-ui-confirm-button-text' }" HorizontalAlignment="Center" Access="Public" />
        </i:BaseImperialButton>
    </BoxContainer>
</iui:ImperialInfoWindow>
