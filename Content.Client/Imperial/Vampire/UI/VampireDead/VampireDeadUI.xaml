<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.Imperial.Vampire.UI.VampireDeadUI"
    Resizable="False"
    SetSize="435 50"
    Title="{Loc 'vampire-dead-title'}">

    <BoxContainer Orientation="Vertical" Margin="3">
        <controls:StripeBack>
        <Label Text="{Loc 'vampire-dead-text'}" Margin="4 4 0 4"/>
        </controls:StripeBack>
        <BoxContainer Orientation="Horizontal" Align="Center">
            <Button Name="ConfirmButton" Margin="5 10"
                    Text="{Loc 'vampire-dead-button'}"/>
        </BoxContainer>
    </BoxContainer>

</controls:FancyWindow>
